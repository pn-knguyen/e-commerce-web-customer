@model CategoryProductSectionViewModel

@{
    var visibleProducts = Model.Products.Take(Model.VisibleProductLimit).ToList();
    var hasMoreProducts = Model.Products.Count > Model.VisibleProductLimit;
}

@if (visibleProducts.Count > 0)
{
    <div class="catalog-section-product-carousel">
        <div class="swiper catalog-section-product-swiper"
             data-section-product-swiper>
            <div class="swiper-wrapper">
                @foreach (var product in visibleProducts)
                {
                    <div class="swiper-slide catalog-section-product-grid__item">
                        <partial name="~/Views/Shared/Partials/_ProductCard.cshtml"
                                 model="product" />
                    </div>
                }
            </div>
        </div>

        <button class="catalog-carousel-button catalog-carousel-button--prev"
                type="button"
                aria-label="Xem sản phẩm trước"
                data-section-product-prev>
            <svg aria-hidden="true"><use href="#hero-icon-chevron-left"></use></svg>
        </button>
        <button class="catalog-carousel-button catalog-carousel-button--next"
                type="button"
                aria-label="Xem sản phẩm tiếp theo"
                data-section-product-next>
            <svg aria-hidden="true"><use href="#hero-icon-chevron"></use></svg>
        </button>
    </div>

    @if (hasMoreProducts)
    {
        <div class="catalog-section-more">
            <a href="@Model.ViewAllUrl">
                Xem tất cả @Model.Products.Count sản phẩm
                <svg aria-hidden="true"><use href="#hero-icon-chevron"></use></svg>
            </a>
        </div>
    }
}
else
{
    <div class="catalog-empty-state">
        <h3>Chưa có sản phẩm</h3>
        <p>Nhóm sản phẩm này đang được cập nhật.</p>
    </div>
}
