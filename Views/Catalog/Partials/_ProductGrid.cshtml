@model CategoryPageViewModel

<section class="catalog-products" aria-label="Danh sách điện thoại">
    <div class="container">
        @{ var totalProductCount = Math.Max(Model.TotalProductCount, Model.Products.Count); }
        @if (Model.Products.Count > 0)
        {
            <div class="catalog-product-grid"
                 data-product-grid
                 aria-busy="false">
                @for (var index = 0; index < Model.Products.Count; index++)
                {
                    <div class="catalog-product-grid__item"
                         data-product-grid-item>
                        <partial name="~/Views/Shared/Partials/_ProductCard.cshtml"
                                 model="Model.Products[index]" />
                    </div>
                }
            </div>

            @if (Model.HasMoreProducts)
            {
                <div class="catalog-load-more">
                    <button type="button"
                            data-load-more
                            data-next-page="@(Model.CurrentPage + 1)"
                            data-total-product-count="@totalProductCount">
                        <span>Xem thêm @(totalProductCount - Model.Products.Count) sản phẩm</span>
                        <i aria-hidden="true"></i>
                    </button>
                </div>
            }
        }
        else
        {
            <div class="catalog-empty-state">
                @if (Model.Filter.ActiveSelectionCount > 0)
                {
                    <h2>Không tìm thấy sản phẩm phù hợp</h2>
                    <p>Hãy bỏ bớt một tiêu chí hoặc xóa bộ lọc để xem thêm sản phẩm.</p>
                    <a class="btn btn-primary"
                       href="@Model.Filter.PrimaryItems.First().Url">
                        Xóa bộ lọc
                    </a>
                }
                else
                {
                    <h2>Chưa có sản phẩm</h2>
                    <p>Sản phẩm của danh mục này đang được cập nhật.</p>
                    <a class="btn btn-primary" href="/">Về trang chủ</a>
                }
            </div>
        }
    </div>
</section>
