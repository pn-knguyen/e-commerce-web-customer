@model CategoryPageViewModel

@{
    var hidesGlobalFilter = string.Equals(Model.Slug, "do-gia-dung", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Slug, "dien-may", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Slug, "am-thanh", StringComparison.OrdinalIgnoreCase)
        || Model.IsAccessoryDirectory;
}

<div class="catalog-page catalog-page--sectioned"
     data-catalog-page
     data-sectioned-catalog>
    <partial name="~/Views/Catalog/Partials/_SectionedDiscovery.cshtml" model="Model" />

    @if (!hidesGlobalFilter)
    {
        <partial name="~/Views/Catalog/Partials/_FilterToolbar.cshtml" model="Model.Filter" />
    }

    <partial name="~/Views/Catalog/Partials/_SectionNavigation.cshtml" model="Model" />
    <partial name="~/Views/Catalog/Partials/_SectionedProductSections.cshtml" model="Model" />
    <partial name="~/Views/Catalog/Partials/_SeoContent.cshtml" model="Model.SeoContent" />

    <div class="container catalog-question-answer">
        <partial name="~/Views/Shared/Sections/_QuestionAnswer.cshtml"
                 model="Model.QuestionAnswer" />
    </div>

    <partial name="~/Views/Catalog/Partials/_CatalogIconSprite.cshtml" />
</div>
