@model HomeApplianceShowcaseViewModel

@{
    var titleId = $"{Model.Id}-title";
    var gridModifier = Model.Columns.Count == 1 ? " appliance-showcase-grid--single" : string.Empty;
}

<section id="@Model.Id"
         class="appliance-showcase-section"
         aria-labelledby="@titleId">
    <div class="appliance-showcase-shell">
        <div class="appliance-showcase-head">
            <h2 id="@titleId">@Model.Title</h2>

            @if (Model.HeaderLinks.Count > 0)
            {
                <span class="appliance-showcase-divider" aria-hidden="true"></span>
                <nav class="appliance-showcase-filter-list" aria-label="Danh mục đồ gia dụng">
                    @foreach (var link in Model.HeaderLinks)
                    {
                        <a class="appliance-showcase-filter" href="@link.Url">
                            @link.Label
                        </a>
                    }
                </nav>
            }

            <a class="appliance-showcase-view-all"
               href="@Model.ViewAllUrl"
               aria-label="Xem tất cả @Model.Title">
                <span>Xem tất cả</span>
                <span aria-hidden="true">&rsaquo;</span>
            </a>
        </div>

        <div class="appliance-showcase-grid@(gridModifier)">
            @foreach (var column in Model.Columns)
            {
                <article class="appliance-showcase-card" aria-labelledby="@($"{column.Id}-title")">
                    <h3 id="@($"{column.Id}-title")" class="sr-only">@column.Title</h3>

                    <a class="appliance-showcase-banner" href="@column.BannerUrl">
                        <img src="@column.BannerImageUrl"
                             alt="@column.BannerImageAlt"
                             width="640"
                             height="112"
                             loading="lazy"
                             decoding="async" />
                    </a>

                    <div class="appliance-showcase-items">
                        @foreach (var item in column.Items)
                        {
                            <a class="appliance-showcase-item" href="@item.Url">
                                <span class="appliance-showcase-item-media">
                                    <img src="@item.ImageUrl"
                                         alt="@item.ImageAlt"
                                         width="144"
                                         height="144"
                                         loading="lazy"
                                         decoding="async" />
                                </span>
                                <span class="appliance-showcase-item-label">@item.Label</span>
                            </a>
                        }

                        <a class="appliance-showcase-more" href="@column.ViewAllUrl">
                            <span class="appliance-showcase-more-icon" aria-hidden="true">&rsaquo;</span>
                            <span>Xem tất cả</span>
                        </a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
