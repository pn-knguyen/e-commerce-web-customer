
@model AccountProfilePageViewModel

@{
    ViewData["Title"] = "Tài khoản của tôi";
    ViewData["MetaDescription"] = "Quản lý hồ sơ TechStore, lịch sử mua hàng và thông tin tài khoản.";
}

<section class="account-profile-page">
    <div class="account-profile-shell">
        <partial name="_AccountProfileHeader" model="Model.Summary" />

        @if (TempData["ProfileSuccess"] is string profileSuccess)
        {
            <div class="ap-flash ap-flash--success" role="status">@profileSuccess</div>
        }
        @if (TempData["ProfileError"] is string profileError)
        {
            <div class="ap-flash ap-flash--error" role="alert">@profileError</div>
        }

        <div class="ap-layout">
            <partial name="_AccountProfileSidebar" model="Model.ActiveTab" />

            <div class="ap-main">
                @if (Model.IsHistory)
                {
                    <partial name="_AccountOrderHistory"
                             model="@(new AccountOrderHistoryViewModel
                             {
                                 OrderFilter = Model.OrderFilter,
                                 OrderStatusFilters = Model.OrderStatusFilters,
                                 Orders = Model.Orders
                             })" />
                }
                else if (Model.IsInfo)
                {
                    var phoneValue = string.IsNullOrWhiteSpace(Model.Summary.PhoneNumber) ? "-" : Model.Summary.PhoneNumber;
                    var emailValue = string.IsNullOrWhiteSpace(Model.Summary.Email) ? "-" : Model.Summary.Email;

                    <div class="ap-account-info-tab">
                        @if (!Model.HasAddresses)
                        {
                            <div class="ap-address-prompt" role="status">
                                <span class="ap-address-prompt-icon">
                                    <svg aria-hidden="true"><use href="#profile-icon-info"></use></svg>
                                </span>
                                <strong>Thêm địa chỉ để đặt đơn hàng nhanh hơn.</strong>
                                <button type="button" data-address-form-open>Thêm địa chỉ</button>
                            </div>
                        }

                        <section class="ap-panel ap-info-card" aria-labelledby="profile-info-title">
                            <div class="ap-card-title-row">
                                <h2 id="profile-info-title">Thông tin cá nhân</h2>
                                <button class="ap-red-action" type="button">
                                    <svg aria-hidden="true"><use href="#profile-icon-edit"></use></svg>
                                    Cập nhật
                                </button>
                            </div>

                            <dl class="ap-personal-grid">
                                <div>
                                    <dt>Họ và tên:</dt>
                                    <dd>@Model.Summary.FullName</dd>
                                </div>
                                <div>
                                    <dt>Số điện thoại:</dt>
                                    <dd>@phoneValue</dd>
                                </div>
                                <div>
                                    <dt>Giới tính:</dt>
                                    <dd>@Model.Summary.GenderText</dd>
                                </div>
                                <div>
                                    <dt>Email:</dt>
                                    <dd>@emailValue</dd>
                                </div>
                                <div>
                                    <dt>Ngày sinh:</dt>
                                    <dd>@Model.Summary.BirthDateText</dd>
                                </div>
                                <div>
                                    <dt>Địa chỉ mặc định:</dt>
                                    <dd>@Model.Summary.DefaultAddressText</dd>
                                </div>
                            </dl>

                            <form asp-controller="Account"
                                  asp-action="UpdateProfile"
                                  method="post"
                                  class="ap-profile-update-form">
                                @Html.AntiForgeryToken()
                                <div class="ap-profile-form-grid">
                                    <label>
                                        <span>Họ và tên</span>
                                        <input name="FullName"
                                               maxlength="255"
                                               required
                                               autocomplete="name"
                                               value="@Model.Summary.FullName" />
                                    </label>
                                    <label>
                                        <span>Số điện thoại</span>
                                        <input name="PhoneNumber"
                                               maxlength="30"
                                               type="tel"
                                               autocomplete="tel"
                                               value="@Model.Summary.PhoneNumber" />
                                    </label>
                                    <label>
                                        <span>Giới tính</span>
                                        <select name="Gender">
                                            <option value="unknown" selected="@(Model.Summary.GenderValue == "unknown")">Chưa cập nhật</option>
                                            <option value="male" selected="@(Model.Summary.GenderValue == "male")">Nam</option>
                                            <option value="female" selected="@(Model.Summary.GenderValue == "female")">Nữ</option>
                                            <option value="other" selected="@(Model.Summary.GenderValue == "other")">Khác</option>
                                        </select>
                                    </label>
                                    <label>
                                        <span>Email</span>
                                        <input value="@emailValue" readonly />
                                    </label>
                                    <label class="ap-profile-form-wide">
                                        <span>Địa chỉ mặc định</span>
                                        <input value="@Model.Summary.DefaultAddressText" readonly />
                                    </label>
                                </div>
                                <div class="ap-profile-form-actions">
                                    <button class="ap-address-submit" type="submit">Lưu thay đổi</button>
                                </div>
                            </form>
                        </section>

                        <section class="ap-panel ap-address-card" aria-labelledby="profile-address-title">
                            <div class="ap-card-title-row">
                                <h2 id="profile-address-title">Sổ địa chỉ</h2>
                                <button class="ap-red-action" type="button" data-address-form-open>
                                    <svg aria-hidden="true"><use href="#profile-icon-plus"></use></svg>
                                    Thêm địa chỉ
                                </button>
                            </div>

                            <div class="ap-address-form-panel" id="ap-address-form-panel" hidden>
                                <form asp-controller="Account" asp-action="AddAddress" method="post" class="ap-address-form" id="ap-address-form">
                                    @Html.AntiForgeryToken()
                                    <div class="ap-address-form-grid">
                                        <label>
                                            <span>Người nhận</span>
                                            <input name="ContactName" maxlength="255" required autocomplete="name" value="@Model.Summary.FullName" />
                                        </label>
                                        <label>
                                            <span>Số điện thoại</span>
                                            <input name="Phone" maxlength="30" required type="tel" autocomplete="tel" value="@Model.Summary.PhoneNumber" />
                                        </label>
                                        <label>
                                            <span>Tỉnh / Thành phố</span>
                                            <select name="ProvinceCode" id="ap-province" required>
                                                <option value="">Đang tải...</option>
                                            </select>
                                            <input type="hidden" name="ProvinceName" id="ap-province-name" />
                                        </label>
                                        <label>
                                            <span>Quận / Huyện</span>
                                            <select name="DistrictCode" id="ap-district" required disabled>
                                                <option value="">-- Chọn Quận / Huyện --</option>
                                            </select>
                                            <input type="hidden" name="DistrictName" id="ap-district-name" />
                                        </label>
                                        <label>
                                            <span>Phường / Xã</span>
                                            <select name="WardCode" id="ap-ward" required disabled>
                                                <option value="">-- Chọn Phường / Xã --</option>
                                            </select>
                                            <input type="hidden" name="WardName" id="ap-ward-name" />
                                        </label>
                                        <label class="ap-address-form-wide">
                                            <span>Địa chỉ cụ thể</span>
                                            <input name="DetailAddress" maxlength="500" required autocomplete="street-address" placeholder="Số nhà, tên đường, tòa nhà..." />
                                        </label>
                                    </div>
                                    <label class="ap-default-check">
                                        <input type="hidden" name="IsDefault" value="false" />
                                        <input type="checkbox" name="IsDefault" value="true" checked />
                                        <span>Đặt làm địa chỉ mặc định</span>
                                    </label>
                                    <div class="ap-address-form-actions">
                                        <button class="ap-address-submit" type="submit">Lưu địa chỉ</button>
                                        <button class="ap-address-cancel" type="button" data-address-form-close>Hủy</button>
                                    </div>
                                </form>
                            </div>

                            @if (Model.HasAddresses)
                            {
                                <div class="ap-address-list">
                                    @foreach (var address in Model.Addresses)
                                    {
                                        <article class="ap-address-item @(address.IsDefault ? "is-default" : null)">
                                            <div>
                                                <h3>@address.ContactName</h3>
                                                <p>@address.PhoneNumber</p>
                                                <p>@address.AddressText</p>
                                            </div>
                                            @if (address.IsDefault)
                                            {
                                                <span>Mặc định</span>
                                            }
                                            @if (!address.IsDefault)
                                            {
                                                <form asp-controller="Account" asp-action="SetDefaultAddress" method="post" class="ap-address-default-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="addressId" value="@address.Id" />
                                                    <button type="submit">Đặt mặc định</button>
                                                </form>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="ap-address-empty">
                                    <div class="ap-empty-illustration ap-empty-illustration--small">
                                        <span class="ap-empty-bag">S</span>
                                    </div>
                                    <p>Bạn chưa có địa chỉ nào được tạo</p>
                                </div>
                            }
                        </section>

                        <div class="ap-info-bottom-grid">
                            <section class="ap-panel ap-password-card" aria-labelledby="profile-password-title">
                                <div class="ap-card-title-row">
                                    <h2 id="profile-password-title">Mật khẩu</h2>
                                    <button class="ap-red-action" type="button">
                                        <svg aria-hidden="true"><use href="#profile-icon-edit"></use></svg>
                                        Thay đổi mật khẩu
                                    </button>
                                </div>

                                <dl class="ap-password-row">
                                    <dt>Cập nhật lần cuối lúc:</dt>
                                    <dd>@Model.Summary.PasswordUpdatedAtText</dd>
                                </dl>
                            </section>

                            <section class="ap-panel ap-linked-card" aria-labelledby="profile-linked-title">
                                <h2 id="profile-linked-title">Tài khoản liên kết</h2>
                                <div class="ap-linked-list">
                                    @foreach (var linkedAccount in Model.LinkedAccounts)
                                    {
                                        <div class="ap-linked-row">
                                            <span class="ap-provider-logo ap-provider-logo--@linkedAccount.LogoClass">@linkedAccount.LogoText</span>
                                            <strong>@linkedAccount.ProviderName</strong>
                                            <button class="ap-red-action" type="button">
                                                <svg aria-hidden="true"><use href="#profile-icon-link"></use></svg>
                                                Liên kết
                                            </button>
                                        </div>
                                    }
                                </div>
                            </section>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ap-overview-grid">
                        <section class="ap-panel ap-recent-panel" aria-labelledby="recent-orders-title">
                            <div class="ap-panel-title-row">
                                <h2 id="recent-orders-title">Đơn hàng gần đây</h2>
                                <a asp-controller="Account" asp-action="Profile" asp-route-tab="@AccountProfileTabs.History">
                                    Xem tất cả
                                    <svg aria-hidden="true"><use href="#profile-icon-chevron"></use></svg>
                                </a>
                            </div>

                            <div class="ap-order-list ap-order-list--compact">
                                @if (Model.RecentOrders.Count == 0)
                                {
                                    <div class="ap-empty-order">Bạn chưa có đơn hàng nào.</div>
                                }
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <partial name="_ProfileOrderCard" model="order" />
                                }
                            </div>
                        </section>

                        <section class="ap-panel ap-offer-panel" aria-labelledby="profile-offer-title">
                            <h2 id="profile-offer-title">Ưu đãi của bạn</h2>
                            @if (Model.HasVouchers)
                            {
                                <div class="ap-voucher-list">
                                    @foreach (var voucher in Model.Vouchers.Take(5))
                                    {
                                        <article class="ap-voucher-card ap-voucher-card--@voucher.Tone @(voucher.IsAvailable ? null : "is-disabled")">
                                            <div class="ap-voucher-badge">@voucher.DiscountText</div>
                                            <div class="ap-voucher-copy">
                                                <div>
                                                    <strong>@voucher.Code</strong>
                                                    @if (voucher.IsAssignedToUser)
                                                    {
                                                        <span>Dành riêng</span>
                                                    }
                                                </div>
                                                <p>@voucher.Description</p>
                                                <small>@voucher.ConditionText</small>
                                            </div>
                                            <div class="ap-voucher-meta">
                                                <span>@voucher.ExpiryText</span>
                                                <span>@voucher.UsageText</span>
                                            </div>
                                            <a class="ap-voucher-action" href="/catalog">Mua sắm</a>
                                        </article>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="ap-empty-illustration">
                                    <span class="ap-empty-bag">S</span>
                                </div>
                                <p>Bạn chưa có ưu đãi nào. <a href="/deals">Xem sản phẩm</a></p>
                            }
                        </section>
                    </div>

                    <section class="ap-panel ap-favorite-panel" aria-labelledby="profile-favorite-title">
                        <h2 id="profile-favorite-title">Sản phẩm yêu thích</h2>
                        @if (!Model.HasFavoriteProducts)
                        {
                            <div class="ap-favorite-empty">
                            <div class="ap-empty-illustration ap-empty-illustration--small">
                                <span class="ap-empty-bag">S</span>
                            </div>
                            <p>Bạn chưa có sản phẩm nào yêu thích? Hãy bắt đầu mua sắm ngay nào! <a href="/catalog">Mua sắm ngay</a></p>
                            </div>
                        }
                        else
                        {
                            <div class="ap-favorite-list" data-profile-favorite-list>
                                @foreach (var product in Model.FavoriteProducts)
                                {
                                    <article class="ap-favorite-item" data-profile-favorite-item data-product-id="@product.ProductVariantKey">
                                        <a class="ap-favorite-thumb" href="@product.DetailUrl" aria-label="Xem @product.Name">
                                            <img src="@product.ImageUrl" alt="@product.ImageAlt" width="72" height="72" loading="lazy" />
                                        </a>
                                        <div class="ap-favorite-info">
                                            <a class="ap-favorite-name" href="@product.DetailUrl">@product.Name</a>
                                            <span class="ap-favorite-price">@product.PriceText</span>
                                            <span class="ap-favorite-stock @(product.IsAvailable ? "is-available" : "is-unavailable")">@product.AvailabilityText</span>
                                        </div>
                                        <div class="ap-favorite-actions">
                                            <a class="ap-favorite-detail" href="@product.DetailUrl">Xem chi tiết</a>
                                            <button type="button"
                                                    class="ap-favorite-remove"
                                                    data-profile-wishlist-remove
                                                    data-product-id="@product.ProductVariantKey"
                                                    data-product-name="@product.Name">
                                                Bỏ yêu thích
                                            </button>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        </div>
    </div>

    <partial name="_AccountProfileMobileNav" model="Model.ActiveTab" />
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account-profile.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/account-profile.js" asp-append-version="true"></script>
}
