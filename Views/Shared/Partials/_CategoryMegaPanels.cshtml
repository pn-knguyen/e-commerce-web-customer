@model SiteCategoryMegaPanelsViewModel

<div class="@Model.StageClass"
     data-category-mega-stage>
    @foreach (var category in Model.Items)
    {
        var megaPanelId = $"{Model.IdPrefix}-{category.Id}-mega";
        var labelId = $"{Model.IdPrefix}-{category.Id}-menu-label";
        var isApplianceGrid = category.Groups.Any(group => HasGroupClass(group, "appliance"));
        var isComputerGrid = category.Groups.Any(group => HasGroupClass(group, "computer"));
        var isLaptopGrid = category.Groups.Any(group => HasGroupClass(group, "laptop"));
        var isAudioGrid = category.Groups.Any(group => HasGroupClass(group, "audio"));
        var gridClass = isApplianceGrid
            ? "site-category-mega-grid site-category-mega-grid--appliance"
            : isLaptopGrid
                ? "site-category-mega-grid site-category-mega-grid--laptop"
            : isComputerGrid
                ? "site-category-mega-grid site-category-mega-grid--computer"
            : isAudioGrid
                ? "site-category-mega-grid site-category-mega-grid--audio"
            : "site-category-mega-grid";
        var panelClass = isLaptopGrid
            ? "site-category-mega-panel site-category-mega-panel--laptop"
            : isAudioGrid
                ? "site-category-mega-panel site-category-mega-panel--audio"
            : "site-category-mega-panel";

        <section class="@panelClass"
                 id="@megaPanelId"
                 aria-labelledby="@labelId"
                 aria-hidden="true"
                 data-category-mega-panel
                 hidden>
            <div class="@gridClass">
                @if (isApplianceGrid)
                {
                    var homeGroup = category.Groups.FirstOrDefault(group => HasGroupClass(group, "appliance-home"));
                    var kitchenGroup = category.Groups.FirstOrDefault(group => HasGroupClass(group, "appliance-kitchen"));
                    var beautyGroup = category.Groups.FirstOrDefault(group => HasGroupClass(group, "appliance-beauty"));
                    var priceGroup = category.Groups.FirstOrDefault(group => HasGroupClass(group, "appliance-price"));
                    var brandGroup = category.Groups.FirstOrDefault(group => HasGroupClass(group, "appliance-brands"));
                    var arrangedGroups = new[] { homeGroup, kitchenGroup, beautyGroup, priceGroup, brandGroup }
                        .Where(group => group is not null)
                        .ToHashSet();
                    var remainingGroups = category.Groups
                        .Where(group => !arrangedGroups.Contains(group))
                        .ToList();

                    <div class="site-category-mega-column site-category-mega-column--appliance-main">
                        @foreach (var group in new[] { homeGroup, kitchenGroup }.Where(group => group is not null))
                        {
                            <section class="@BuildGroupClass(group!)">
                                <h4>@group!.Title</h4>
                                <div class="site-category-mega-links">
                                    @foreach (var link in group.Links)
                                    {
                                        <a class="@BuildLinkClass(link)" href="@link.Url">
                                            @if (!string.IsNullOrWhiteSpace(link.ImageUrl))
                                            {
                                                <img src="@link.ImageUrl"
                                                     alt="@(link.ImageAlt ?? string.Empty)"
                                                     width="76"
                                                     height="28"
                                                     loading="lazy" />

                                                @if (!link.ImageOnly)
                                                {
                                                    <span>@link.Label</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>@link.Label</span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(link.Badge))
                                            {
                                                <small>@link.Badge</small>
                                            }
                                        </a>
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    <div class="site-category-mega-column site-category-mega-column--appliance-beauty">
                        @foreach (var group in new[] { beautyGroup, priceGroup }.Where(group => group is not null))
                        {
                            <section class="@BuildGroupClass(group!)">
                                <h4>@group!.Title</h4>
                                <div class="site-category-mega-links">
                                    @foreach (var link in group.Links)
                                    {
                                        <a class="@BuildLinkClass(link)" href="@link.Url">
                                            @if (!string.IsNullOrWhiteSpace(link.ImageUrl))
                                            {
                                                <img src="@link.ImageUrl"
                                                     alt="@(link.ImageAlt ?? string.Empty)"
                                                     width="76"
                                                     height="28"
                                                     loading="lazy" />

                                                @if (!link.ImageOnly)
                                                {
                                                    <span>@link.Label</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>@link.Label</span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(link.Badge))
                                            {
                                                <small>@link.Badge</small>
                                            }
                                        </a>
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    <div class="site-category-mega-column site-category-mega-column--appliance-brands">
                        @if (brandGroup is not null)
                        {
                            <section class="@BuildGroupClass(brandGroup)">
                                <h4>@brandGroup.Title</h4>
                                <div class="site-category-mega-links">
                                    @foreach (var link in brandGroup.Links)
                                    {
                                        <a class="@BuildLinkClass(link)" href="@link.Url">
                                            @if (!string.IsNullOrWhiteSpace(link.ImageUrl))
                                            {
                                                <img src="@link.ImageUrl"
                                                     alt="@(link.ImageAlt ?? string.Empty)"
                                                     width="76"
                                                     height="28"
                                                     loading="lazy" />

                                                @if (!link.ImageOnly)
                                                {
                                                    <span>@link.Label</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>@link.Label</span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(link.Badge))
                                            {
                                                <small>@link.Badge</small>
                                            }
                                        </a>
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    @foreach (var group in remainingGroups)
                    {
                        <section class="@BuildGroupClass(group)">
                            <h4>@group.Title</h4>
                            <div class="site-category-mega-links">
                                @foreach (var link in group.Links)
                                {
                                    <a class="@BuildLinkClass(link)" href="@link.Url">
                                        @if (!string.IsNullOrWhiteSpace(link.ImageUrl))
                                        {
                                            <img src="@link.ImageUrl"
                                                 alt="@(link.ImageAlt ?? string.Empty)"
                                                 width="76"
                                                 height="28"
                                                 loading="lazy" />

                                            @if (!link.ImageOnly)
                                            {
                                                <span>@link.Label</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>@link.Label</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(link.Badge))
                                        {
                                            <small>@link.Badge</small>
                                        }
                                    </a>
                                }
                            </div>
                        </section>
                    }
                }
                else if (isLaptopGrid)
                {
                    var laptopColumns = DistributeMegaGroups(category.Groups, 3);

                    @foreach (var column in laptopColumns)
                    {
                        <div class="site-category-mega-column site-category-mega-column--laptop">
                            @foreach (var group in column)
                            {
                                <section class="@BuildGroupClass(group)">
                                    <h4>@group.Title</h4>
                                    <div class="site-category-mega-links">
                                        @foreach (var link in group.Links)
                                        {
                                            <a class="@BuildLinkClass(link)" href="@link.Url">
                                                @if (!string.IsNullOrWhiteSpace(link.ImageUrl))
                                                {
                                                    <img src="@link.ImageUrl"
                                                         alt="@(link.ImageAlt ?? string.Empty)"
                                                         width="76"
                                                         height="28"
                                                         loading="lazy" />

                                                    @if (!link.ImageOnly)
                                                    {
                                                        <span>@link.Label</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>@link.Label</span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(link.Badge))
                                                {
                                                    <small>@link.Badge</small>
                                                }
                                            </a>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    }
                }
                else if (isAudioGrid)
                {
                    var audioColumns = DistributeMegaGroups(category.Groups, 3);

                    @foreach (var column in audioColumns)
                    {
                        <div class="site-category-mega-column site-category-mega-column--audio">
                            @foreach (var group in column)
                            {
                                <section class="@BuildGroupClass(group)">
                                    <h4>@group.Title</h4>
                                    <div class="site-category-mega-links">
                                        @foreach (var link in group.Links)
                                        {
                                            <a class="@BuildLinkClass(link)" href="@link.Url">
                                                @if (!string.IsNullOrWhiteSpace(link.ImageUrl))
                                                {
                                                    <img src="@link.ImageUrl"
                                                         alt="@(link.ImageAlt ?? string.Empty)"
                                                         width="76"
                                                         height="28"
                                                         loading="lazy" />

                                                    @if (!link.ImageOnly)
                                                    {
                                                        <span>@link.Label</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>@link.Label</span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(link.Badge))
                                                {
                                                    <small>@link.Badge</small>
                                                }
                                            </a>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    }
                }
                else if (isComputerGrid)
                {
                    var computerColumns = DistributeMegaGroups(category.Groups, 3);

                    @foreach (var column in computerColumns)
                    {
                        <div class="site-category-mega-column site-category-mega-column--computer">
                            @foreach (var group in column)
                            {
                                <section class="@BuildGroupClass(group)">
                                    <h4>@group.Title</h4>
                                    <div class="site-category-mega-links">
                                        @foreach (var link in group.Links)
                                        {
                                            <a class="@BuildLinkClass(link)" href="@link.Url">
                                                @if (!string.IsNullOrWhiteSpace(link.ImageUrl))
                                                {
                                                    <img src="@link.ImageUrl"
                                                         alt="@(link.ImageAlt ?? string.Empty)"
                                                         width="76"
                                                         height="28"
                                                         loading="lazy" />

                                                    @if (!link.ImageOnly)
                                                    {
                                                        <span>@link.Label</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>@link.Label</span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(link.Badge))
                                                {
                                                    <small>@link.Badge</small>
                                                }
                                            </a>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    }
                }
                else
                {
                    @foreach (var group in category.Groups)
                    {
                        <section class="@BuildGroupClass(group)">
                            <h4>@group.Title</h4>
                            <div class="site-category-mega-links">
                                @foreach (var link in group.Links)
                                {
                                    <a class="@BuildLinkClass(link)" href="@link.Url">
                                        @if (!string.IsNullOrWhiteSpace(link.ImageUrl))
                                        {
                                            <img src="@link.ImageUrl"
                                                 alt="@(link.ImageAlt ?? string.Empty)"
                                                 width="76"
                                                 height="28"
                                                 loading="lazy" />

                                            @if (!link.ImageOnly)
                                            {
                                                <span>@link.Label</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>@link.Label</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(link.Badge))
                                        {
                                            <small>@link.Badge</small>
                                        }
                                    </a>
                                }
                            </div>
                        </section>
                    }
                }
            </div>
        </section>
    }
</div>

@functions {
    private static bool HasGroupClass(
        SiteCategoryMenuGroupViewModel group,
        string className)
    {
        return !string.IsNullOrWhiteSpace(group.CssClass)
            && group.CssClass.Contains(className, StringComparison.OrdinalIgnoreCase);
    }

    private static string BuildGroupClass(SiteCategoryMenuGroupViewModel group)
    {
        var groupClass = "site-category-mega-group";
        if (!string.IsNullOrWhiteSpace(group.CssClass))
        {
            groupClass += $" {group.CssClass}";
        }

        return groupClass;
    }

    private static IReadOnlyList<IReadOnlyList<SiteCategoryMenuGroupViewModel>> DistributeMegaGroups(
        IReadOnlyList<SiteCategoryMenuGroupViewModel> groups,
        int columnCount)
    {
        var columns = Enumerable.Range(0, columnCount)
            .Select(_ => new List<SiteCategoryMenuGroupViewModel>())
            .ToList();
        var weights = new int[columnCount];

        foreach (var group in groups)
        {
            var columnIndex = Array.IndexOf(weights, weights.Min());
            columns[columnIndex].Add(group);
            weights[columnIndex] += Math.Max(1, group.Links.Count);
        }

        return columns;
    }

    private static string BuildLinkClass(SiteCategoryMenuLinkViewModel link)
    {
        var linkClass = "site-category-mega-link";
        if (!string.IsNullOrWhiteSpace(link.ImageUrl))
        {
            linkClass += " site-category-mega-link--media";
        }

        if (link.ImageOnly)
        {
            linkClass += " site-category-mega-link--logo";
        }

        return linkClass;
    }
}
